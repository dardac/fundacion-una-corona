---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Imagen España 2026';
const description =
  'Dr. Pedro León Amaya — Imagen de Una Corona por la Vida en España y Patrocinador Oficial de la Gala Humanitaria Internacional Madrid 2026.';

const photos = [
  {
    src: '/entrevista/pedro-leon-1.webp',
    alt: 'Dr. Pedro León Amaya, cirujano plástico',
  },
  {
    src: '/entrevista/pedro-leon-2.webp',
    alt: 'Retrato profesional del Dr. Pedro León Amaya',
  },
  {
    src: '/entrevista/pedro-leon-3.webp',
    alt: 'Dr. Pedro León Amaya en estudio',
  },
] as const;
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <article class="relative overflow-x-clip">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-[42rem]"
      aria-hidden="true"
      style="background:
        radial-gradient(ellipse 70% 45% at 50% 0%, color-mix(in oklab, var(--color-gold) 16%, transparent), transparent 58%),
        linear-gradient(180deg, #0a0a0a 0%, transparent 100%);"
    >
    </div>

    <header class="section-pad relative pb-8 sm:pb-10">
      <div class="section-narrow">
        <p
          class="text-xs font-semibold tracking-[0.24em] text-gold uppercase"
          data-reveal
          data-reveal-line
        >
          Imagen España 2026
        </p>
        <h1
          class="mt-5 text-3xl leading-tight sm:text-4xl lg:text-5xl"
          data-reveal
          data-reveal-delay="80"
        >
          Dr. Pedro León Amaya
        </h1>
        <p
          class="mt-5 text-lg text-cream/95 sm:text-xl"
          data-reveal
          data-reveal-delay="140"
        >
          El arte de transformar, la excelencia de servir
        </p>
      </div>
    </header>

    <figure
      class="section-wide relative px-6 sm:px-8 lg:px-10"
      data-reveal
      data-reveal-delay="120"
    >
      <img
        src={photos[0].src}
        alt={photos[0].alt}
        width="1200"
        height="1500"
        class="mx-auto h-auto w-full max-w-3xl object-cover object-top"
        fetchpriority="high"
        decoding="async"
      />
    </figure>

    <div class="section-pad relative pt-10 sm:pt-12">
      <div class="section-narrow space-y-6 text-base text-muted sm:text-lg">
        <p data-reveal>
          El Dr. Pedro León Amaya, reconocido cirujano plástico de trayectoria internacional,
          representa en España la unión entre medicina, arte, excelencia profesional y compromiso
          humano.
        </p>
        <p data-reveal data-reveal-delay="80">
          Su visión de la transformación va más allá de la dimensión estética. En ella convergen la
          precisión científica, la sensibilidad artística y una profunda comprensión del bienestar
          de cada persona. Esa filosofía, reflejada en la entrevista “El arte de transformar”
          publicada por Revista Suroeste, forma parte de la esencia que hoy lo vincula con Una
          Corona por la Vida.
        </p>
      </div>

      <!-- Mobile: foto → texto → foto. Desktop: las dos fotos juntas, luego el texto. -->
      <div
        class="section-wide mt-14 grid gap-10 px-0 sm:mt-16 sm:grid-cols-2 sm:gap-x-6 sm:gap-y-14"
      >
        <img
          src={photos[1].src}
          alt={photos[1].alt}
          width="900"
          height="1125"
          class="h-auto w-full object-cover"
          loading="lazy"
          decoding="async"
          data-reveal
        />

        <div
          class="section-narrow w-full justify-self-center sm:order-3 sm:col-span-2"
          data-reveal
        >
          <p class="text-base text-muted sm:text-lg">
            Por su trayectoria y por su compromiso con la responsabilidad social, el arte y el
            bienestar humano, el Dr. Pedro León Amaya ha sido incorporado como imagen y figura
            representativa de los Premios Humanitarios Internacionales “Una Corona por la Vida” en
            España, además de participar como Patrocinador Oficial de esta iniciativa internacional.
          </p>
        </div>

        <img
          src={photos[2].src}
          alt={photos[2].alt}
          width="900"
          height="1125"
          class="h-auto w-full object-cover sm:order-2"
          loading="lazy"
          decoding="async"
          data-reveal
        />
      </div>

      <div class="section-narrow mt-14 space-y-8 sm:mt-16 sm:space-y-10">
        <p class="text-base text-muted sm:text-lg" data-reveal>
          Su presencia simboliza uno de los principios fundamentales de nuestro galardón:
        </p>

        <blockquote
          class="border-l-2 border-gold/50 pl-5 text-lg leading-relaxed text-cream sm:pl-6 sm:text-xl"
          data-reveal
        >
          <p>
            La verdadera excelencia adquiere sentido cuando el talento, el conocimiento y la
            profesión se ponen al servicio de la vida y de la dignidad humana.
          </p>
        </blockquote>

        <footer class="pt-4" data-reveal>
          <p class="font-display text-xl tracking-wide text-gold-bright sm:text-2xl">
            Pedro León Amaya
          </p>
          <p class="mt-3 text-base text-cream/90">
            Imagen de “Una Corona por la Vida” en España
          </p>
          <p class="mt-1 text-base text-muted">
            Patrocinador Oficial — Gala Humanitaria Internacional Madrid 2026
          </p>
          <p class="mt-6 text-sm tracking-wide text-gold">
            10 de octubre de 2026 · Hotel Meliá Princesa · Madrid, España
          </p>
        </footer>
      </div>

      <p class="section-narrow mt-12 text-center" data-reveal>
        <a href="/" class="text-sm text-muted no-underline hover:text-gold-bright">
          ← Volver a Una Corona por la Vida
        </a>
      </p>
    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>
