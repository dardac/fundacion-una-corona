---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import MissionVision from '../components/sections/MissionVision.astro';
import Purpose from '../components/sections/Purpose.astro';
import Ethics from '../components/sections/Ethics.astro';
import Donate from '../components/sections/Donate.astro';
import Contact from '../components/sections/Contact.astro';
---

<BaseLayout>
  <Header slot="header" />
  <Hero />
  <About />
  <MissionVision />
  <Purpose />
  <Ethics />
  <Donate />
  <Contact />
  <Footer slot="footer" />
</BaseLayout>
