---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import MissionVision from '../components/sections/MissionVision.astro';
import Purpose from '../components/sections/Purpose.astro';
import Ethics from '../components/sections/Ethics.astro';
import Members from '../components/sections/Members.astro';
import Recognitions from '../components/sections/Recognitions.astro';
import Donate from '../components/sections/Donate.astro';
import Contact from '../components/sections/Contact.astro';
---

<BaseLayout>
  <Header slot="header" />
  <Hero />
  <section id="quienes-somos" class="scroll-mt-[calc(4.25rem+env(safe-area-inset-top,0px))]">
    <About />
    <MissionVision />
    <Purpose />
  </section>
  <Ethics />
  <Members />
  <Recognitions />
  <Donate />
  <Contact />
  <Footer slot="footer" />
</BaseLayout>
