---
import { SITE, whatsappHref } from '../../consts';

const { payment } = SITE;
const showLabel = 'Ver datos para pagos por Zelle';
const hideLabel = 'Ocultar datos de Zelle';
---

<section id="donar" class="section-pad border-t border-gold/10 bg-ink/60">
  <div class="section-wide grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-start lg:gap-14">
    <div data-reveal="left">
      <p
        class="text-xs font-semibold tracking-[0.24em] text-gold uppercase"
        data-reveal-line
      >
        Donar
      </p>
      <h2 class="mt-4 text-3xl sm:text-4xl">Apoya la recaudación</h2>
      <p class="mt-3 font-display text-lg text-gold-bright">
        {SITE.campaign}
      </p>
      <p class="mt-6 text-base text-muted sm:text-lg">
        Organizada por {SITE.acronym} ({SITE.org}).
      </p>
      <a
        href={whatsappHref()}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex min-h-12 items-center justify-center rounded-md border border-gold/40 px-6 text-base text-gold-bright no-underline hover:border-gold hover:bg-gold/10"
      >
        Confirmar donación por WhatsApp
      </a>
    </div>

    <div class="space-y-3" role="region" aria-label="Método de pago">
      <h3 class="mb-2 text-xl text-gold-bright" data-reveal="right" data-reveal-delay="60">
        Método de pago
      </h3>
      <p class="mb-6 text-sm text-muted" data-reveal="right" data-reveal-delay="120">
        Donaciones por Zelle.
      </p>

      <div
        class="overflow-hidden rounded-lg border border-gold/20 bg-void/80"
        data-reveal="right"
        data-reveal-delay="180"
      >
        <button
          type="button"
          class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left text-sm text-gold-bright transition-colors hover:bg-gold/5 sm:text-base"
          aria-expanded="false"
          aria-controls="panel-zelle"
          data-payment-toggle
          data-hide-label={hideLabel}
          data-show-label={showLabel}
        >
          <span data-payment-label>{showLabel}</span>
          <svg
            class="h-5 w-5 shrink-0 text-gold transition-transform duration-300"
            data-payment-chevron
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M6 9l6 6 6-6"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
            </path>
          </svg>
        </button>

        <div id="panel-zelle" class="payment-panel" data-payment-panel hidden>
          <div class="border-t border-gold/15 px-5 pb-5 pt-4">
            <dl class="space-y-3 text-sm sm:text-base">
              <div>
                <dt class="text-xs tracking-wide text-muted uppercase">Zelle</dt>
                <dd class="mt-1 break-all text-cream">{payment.zelle.email}</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .payment-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.35s ease,
      opacity 0.28s ease;
  }

  .payment-panel > div {
    overflow: hidden;
  }

  .payment-panel.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .payment-panel {
      transition: none;
    }
  }
</style>

<script>
  const button = document.querySelector('[data-payment-toggle]');
  if (button instanceof HTMLElement) {
    button.addEventListener('click', () => {
      const panelId = button.getAttribute('aria-controls');
      const panel = panelId ? document.getElementById(panelId) : null;
      if (!panel) return;

      const willOpen = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(willOpen));

      const label = button.querySelector('[data-payment-label]');
      const chevron = button.querySelector('[data-payment-chevron]');

      if (willOpen) {
        panel.removeAttribute('hidden');
        void panel.offsetHeight;
        panel.classList.add('is-open');
        if (label) label.textContent = button.dataset.hideLabel ?? '';
        chevron?.classList.add('rotate-180');
      } else {
        panel.classList.remove('is-open');
        if (label) label.textContent = button.dataset.showLabel ?? '';
        chevron?.classList.remove('rotate-180');
        window.setTimeout(() => {
          if (button.getAttribute('aria-expanded') !== 'true') {
            panel.setAttribute('hidden', '');
          }
        }, 320);
      }
    });
  }
</script>
