---
import { MEMBERS } from '../../data/members';

const first = MEMBERS[0];
---

<section id="miembros" class="section-pad overflow-x-clip border-t border-gold/10 bg-ink/60">
  <div class="section-wide min-w-0">
    <div class="max-w-3xl">
      <p
        class="text-xs font-semibold tracking-[0.24em] text-gold uppercase"
        data-reveal
        data-reveal-line
      >
        Miembros
      </p>
      <h2 class="mt-4 text-balance text-3xl sm:text-4xl" data-reveal data-reveal-delay="80">
        El equipo directivo y Comité Organizador
      </h2>
      <p
        class="mt-3 font-display text-lg text-gold-bright sm:text-xl"
        data-reveal
        data-reveal-delay="120"
      >
        Las mentes detrás de la gala
      </p>
      <p class="mt-5 text-base text-muted sm:text-lg" data-reveal data-reveal-delay="180">
        El éxito de una estructura internacional radica en la excelencia de sus líderes. La Gala
        cuenta con un equipo directivo, técnico y operacional de alta competencia profesional.
      </p>
    </div>

    <div
      class="mt-10 grid min-w-0 items-start gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-14"
      data-members
    >
      <div class="relative mx-auto w-full max-w-md min-w-0 lg:mx-0" data-reveal="scale">
        <div class="overflow-hidden border border-gold/20 bg-void">
          <img
            src={first.photo}
            alt={first.name}
            width="720"
            height="900"
            class="aspect-[4/5] h-auto w-full max-w-full object-cover object-top transition-opacity duration-500"
            data-member-photo
            decoding="async"
          />
        </div>
      </div>

      <div class="min-w-0 w-full" data-reveal data-reveal-delay="100">
        <p
          class="text-xs font-semibold tracking-[0.2em] text-gold uppercase"
          data-member-role
        >
          {first.role}
        </p>
        <h3 class="mt-3 text-balance text-2xl text-gold-bright sm:text-3xl" data-member-name>
          {first.name}
        </h3>
        <p
          class="mt-6 min-h-[8rem] text-pretty break-words text-base text-muted sm:text-lg"
          data-member-bio
        >
          {first.bio}
        </p>

        <div class="mt-10 flex min-w-0 items-center gap-2 sm:gap-3">
          <button
            type="button"
            class="hidden h-10 w-10 shrink-0 items-center justify-center border border-gold/30 text-gold-bright transition hover:border-gold hover:bg-gold/10 disabled:cursor-not-allowed disabled:opacity-30 md:inline-flex"
            data-member-prev
            aria-label="Miembro anterior"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M15 6l-6 6 6 6"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
              </path>
            </svg>
          </button>

          <div
            class="w-full min-w-0 max-w-full overflow-x-auto overscroll-x-contain pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
            role="tablist"
            aria-label="Seleccionar miembro"
            data-member-scroller
          >
            <div class="flex w-max gap-3">
              {
                MEMBERS.map((member, index) => (
                  <button
                    type="button"
                    id={`member-tab-${member.id}`}
                    role="tab"
                    aria-selected={index === 0 ? 'true' : 'false'}
                    aria-controls="member-panel"
                    tabindex={index === 0 ? 0 : -1}
                    class="group relative h-16 w-16 shrink-0 overflow-hidden border border-gold/25 transition duration-300 focus-visible:outline-none sm:h-20 sm:w-20 data-[active=true]:border-gold data-[active=true]:shadow-[0_0_0_1px_var(--color-gold)]"
                    data-member-tab
                    data-member-id={member.id}
                    data-name={member.name}
                    data-role={member.role}
                    data-bio={member.bio}
                    data-photo={member.photo}
                    data-active={index === 0 ? 'true' : 'false'}
                  >
                    <img
                      src={member.photo}
                      alt=""
                      width="80"
                      height="80"
                      class="h-full w-full object-cover object-top opacity-55 transition duration-300 group-hover:opacity-90 group-data-[active=true]:opacity-100"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="sr-only">{member.name}, {member.role}</span>
                  </button>
                ))
              }
            </div>
          </div>

          <button
            type="button"
            class="hidden h-10 w-10 shrink-0 items-center justify-center border border-gold/30 text-gold-bright transition hover:border-gold hover:bg-gold/10 disabled:cursor-not-allowed disabled:opacity-30 md:inline-flex"
            data-member-next
            aria-label="Miembro siguiente"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M9 6l6 6-6 6"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
              </path>
            </svg>
          </button>
        </div>
        <p class="mt-4 text-xs tracking-wide text-muted/80" aria-hidden="true">
          Selecciona un perfil para conocer más
        </p>
      </div>
    </div>

    <div id="member-panel" role="tabpanel" aria-labelledby={`member-tab-${first.id}`} class="sr-only">
      {first.name}
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-members]');

  if (root) {
    const photo = root.querySelector<HTMLImageElement>('[data-member-photo]');
    const nameEl = root.querySelector('[data-member-name]');
    const roleEl = root.querySelector('[data-member-role]');
    const bioEl = root.querySelector('[data-member-bio]');
    const panel = document.getElementById('member-panel');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-member-prev]');
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-member-next]');
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-member-tab]'));

    function updateArrowState(index: number) {
      if (prevBtn) prevBtn.disabled = index <= 0;
      if (nextBtn) nextBtn.disabled = index >= tabs.length - 1;
    }

    function setActive(tab: HTMLButtonElement) {
      tabs.forEach((other) => {
        const active = other === tab;
        other.dataset.active = String(active);
        other.setAttribute('aria-selected', String(active));
        other.tabIndex = active ? 0 : -1;
      });

      const nextName = tab.dataset.name ?? '';
      const nextRole = tab.dataset.role ?? '';
      const nextBio = tab.dataset.bio ?? '';
      const nextPhoto = tab.dataset.photo ?? '';
      const activeIndex = tabs.indexOf(tab);
      updateArrowState(activeIndex);

      tab.scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });

      const fade = (el: Element | null) => {
        if (!(el instanceof HTMLElement)) return;
        el.style.opacity = '0';
        el.style.transform = 'translateY(0.4rem)';
        window.setTimeout(() => {
          el.style.opacity = '1';
          el.style.transform = 'translateY(0)';
        }, 180);
      };

      [nameEl, roleEl, bioEl, photo].forEach((el) => {
        if (el instanceof HTMLElement) {
          el.style.transition = 'opacity 0.28s ease, transform 0.28s ease';
        }
      });

      fade(nameEl);
      fade(roleEl);
      fade(bioEl);
      fade(photo);

      window.setTimeout(() => {
        if (nameEl) nameEl.textContent = nextName;
        if (roleEl) roleEl.textContent = nextRole;
        if (bioEl) bioEl.textContent = nextBio;
        if (photo) {
          photo.src = nextPhoto;
          photo.alt = nextName;
        }
        if (panel) {
          panel.setAttribute('aria-labelledby', tab.id);
          panel.textContent = nextName;
        }
      }, 160);
    }

    function move(delta: number) {
      const current = tabs.findIndex((tab) => tab.dataset.active === 'true');
      const next = Math.min(tabs.length - 1, Math.max(0, current + delta));
      const tab = tabs[next];
      if (!tab || next === current) return;
      setActive(tab);
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => setActive(tab));
    });

    prevBtn?.addEventListener('click', () => move(-1));
    nextBtn?.addEventListener('click', () => move(1));

    root.addEventListener('keydown', (event) => {
      if (!(event instanceof KeyboardEvent)) return;
      const current = tabs.findIndex((tab) => tab.dataset.active === 'true');
      if (current < 0) return;

      let next = current;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (current + 1) % tabs.length;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (current - 1 + tabs.length) % tabs.length;
      if (event.key === 'Home') next = 0;
      if (event.key === 'End') next = tabs.length - 1;

      if (next !== current) {
        event.preventDefault();
        tabs[next]?.focus();
        setActive(tabs[next]!);
      }
    });

    updateArrowState(0);
  }
</script>
