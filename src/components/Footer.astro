---
import { SITE, whatsappHref } from '../consts';

const year = new Date().getFullYear();
---

<footer class="border-t border-gold/15 bg-ink">
  <div
    class="section-wide flex flex-col gap-8 px-6 py-12 sm:px-8 lg:flex-row lg:items-end lg:justify-between lg:px-10"
    data-reveal
  >
    <div class="max-w-md">
      <p class="font-display text-lg tracking-[0.12em] text-gold-bright uppercase">
        {SITE.acronym}
      </p>
      <p class="mt-2 text-sm text-muted">
        {SITE.org}
      </p>
      <p class="mt-1 text-sm text-cream/80">
        Recaudación: {SITE.campaign}
      </p>
      <p class="mt-1 text-xs tracking-wide text-muted/80">
        RIF {SITE.rif}
      </p>
    </div>

    <div class="flex flex-wrap gap-4 text-sm">
      <a href="#donar" class="text-gold-bright no-underline hover:text-gold">Donar</a>
      <a
        href={whatsappHref()}
        target="_blank"
        rel="noopener noreferrer"
        class="text-gold-bright no-underline hover:text-gold"
      >
        WhatsApp
      </a>
      <a
        href={SITE.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted no-underline hover:text-gold-bright"
      >
        Instagram {SITE.instagram.handle}
      </a>
      <a href="#quienes-somos" class="text-muted no-underline hover:text-gold-bright">Quiénes somos</a>
    </div>
  </div>

  <div class="border-t border-gold/10 px-6 py-5 text-center text-xs text-muted sm:px-8 lg:px-10">
    <p>&copy; {year} {SITE.org}. El reconocimiento no se comercializa ni está a la venta.</p>
  </div>
</footer>
