---
import { SITE, whatsappHref } from '../consts';

const links = [
  { href: '#quienes-somos', label: 'Quiénes somos' },
  { href: '#mision', label: 'Misión' },
  { href: '#pilares', label: 'Pilares' },
  { href: '#donar', label: 'Donar' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header
  class="sticky top-0 z-40 border-b border-gold/15 bg-void/85 backdrop-blur-md"
>
  <div class="section-wide flex items-center justify-between gap-4 px-6 py-3 sm:px-8 lg:px-10">
    <a href="#inicio" class="group flex items-center gap-3 no-underline">
      <img
        src="/images/logo-emblem.jpg"
        alt=""
        width="44"
        height="50"
        class="h-11 w-auto object-contain"
      />
      <span class="hidden flex-col leading-tight sm:flex">
        <span class="font-display text-sm tracking-[0.18em] text-gold-bright uppercase">
          {SITE.acronym}
        </span>
        <span class="text-xs text-muted">{SITE.campaign}</span>
      </span>
      <span class="sr-only">{SITE.acronym} — {SITE.campaign}</span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm text-muted no-underline hover:text-gold-bright"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={whatsappHref()}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-md border border-gold/30 px-3 py-2 text-sm text-gold-bright no-underline hover:border-gold hover:bg-gold/10 sm:inline-flex"
      >
        WhatsApp
      </a>
      <a
        href="#donar"
        class="bg-gold-sheen inline-flex rounded-md px-4 py-2 text-sm font-semibold text-ink no-underline shadow-[0_0_24px_color-mix(in_oklab,var(--color-gold)_25%,transparent)] hover:brightness-110"
      >
        Donar
      </a>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-gold/25 text-gold-bright lg:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-menu-toggle
      >
        <span class="sr-only">Abrir menú</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="menu-movil" class="hidden border-t border-gold/15 bg-ink px-6 py-4 lg:hidden" hidden>
    <nav class="flex flex-col gap-3" aria-label="Móvil">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="py-1 text-base text-cream no-underline hover:text-gold-bright"
            data-menu-link
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={whatsappHref()}
        target="_blank"
        rel="noopener noreferrer"
        class="py-1 text-base text-gold-bright no-underline"
        data-menu-link
      >
        Escribir por WhatsApp
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.getElementById('menu-movil');
  const links = document.querySelectorAll('[data-menu-link]');

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    menu.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setOpen(open);
  });

  links.forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
</script>
